{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunarca",
  "version": "1.0.0",
  "identifier": "app.lunarca.luna",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../apps/desktop"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../apps/desktop"
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Lunarca",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "dragDropEnabled": true,
        "create": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src http://127.0.0.1:* asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; media-src http://127.0.0.1:* asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:*; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": false,
    "copyright": "Copyright © 2026 Weijia Zhao · AGPL-3.0-only",
    "resources": {
      "resources/models/ggml-tiny-q5_1.bin": "models/ggml-tiny-q5_1.bin",
      "resources/samples/lunarca-sample-en.wav": "samples/lunarca-sample-en.wav",
      "resources/samples/ATTRIBUTION.md": "samples/ATTRIBUTION.md",
      "resources/llama/": "llama/"
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "files": {
        "Resources/zh-Hans.lproj/ServicesMenu.strings": "macos/zh-Hans.lproj/ServicesMenu.strings",
        "Resources/en.lproj/ServicesMenu.strings": "macos/en.lproj/ServicesMenu.strings"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lunarca"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0Q0ExRkE5MDZEMDE1ODAKUldTQUZkQUdxUi9LbEViUTlTR3prQ2tPaG4yUTd6V0VESXlJSXI0eW9NSiszL0ZjdVVUamVvdU0K",
      "endpoints": [
        "https://lunarca.app/releases/latest.json"
      ]
    }
  }
}
