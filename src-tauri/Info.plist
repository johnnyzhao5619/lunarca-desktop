<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Lunarca 需要使用麦克风将你的语音在本机转写为文本，用于语音输入与录音功能。</string>
  <!-- 系统音频录制（CATap，PRD-04-052/ADR-019）：TCC「系统音频录制」独立类别的授权文案；
       缺此 key 正式签名构建不弹授权框（TDD-02 §7）。 -->
  <key>NSAudioCaptureUsageDescription</key>
  <string>Lunarca 需要录制系统音频，以便在会议、视频场景把对方（系统播放）的声音在本机转写为文字；全程本地处理，不上传。</string>
  <!-- 本地网络（macOS 15 起的 TCC 类别）：连接部署在局域网里的组织服务端、从它下载模型时
       系统会弹授权框，缺此 key 框里没有说明。授权按签名身份记录——ad-hoc 调试包每次重编译
       都要重新授权，期间连局域网地址一律失败（实测，TDD-13 §签名）。 -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Lunarca 需要访问本地网络，以连接你的组织部署在局域网内的 Lunarca 服务端，并从那里同步模型目录和下载模型。</string>
  <!-- macOS「服务」菜单（笔记库对标轮 W5b）：别的应用里选中文字 → 服务 →「用 Lunarca 存为速记」。
       NSMessage 与 src/platform/macos/services.rs 的选择子一一对应；NSRequiredContext 为空字典 =
       默认启用（缺了它，系统把新服务默认关着，用户得去系统设置里手动打开）。菜单名按系统语言取
       macos/<语言>.lproj/ServicesMenu.strings，default 只是键。 -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>Save to Lunarca as Quick Note</string>
      </dict>
      <key>NSMessage</key>
      <string>saveAsQuickNote</string>
      <key>NSPortName</key>
      <string>Lunarca</string>
      <key>NSSendTypes</key>
      <array>
        <string>public.utf8-plain-text</string>
        <string>NSStringPboardType</string>
      </array>
      <key>NSRequiredContext</key>
      <dict/>
    </dict>
  </array>
</dict>
</plist>
