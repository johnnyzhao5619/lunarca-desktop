{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lunarca 默认能力（最小权限，TDD-12 §4）。后续按功能逐步细分 capability。",
  "windows": [
    "main",
    "popup-translate",
    "voice-input-hud",
    "quick-chat",
    "text-quick-note",
    "recording-hud",
    "live-caption",
    "teleprompter",
    "live-caption-translation",
    "screenshot-overlay-*",
    "desktop-lens",
    "desktop-lens-trigger",
    "desktop-note-*",
    "note-editor-*",
    "note-print-*",
    "vault-window-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-position",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "luna-cloud:default",
    "notification:default"
  ]
}
